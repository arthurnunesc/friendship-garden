# Set these in the server environment, never with a VITE_ or EXPO_PUBLIC_ prefix.
# Use a dedicated development database and provider project, not production data.
BETTER_AUTH_URL=https://your-development-domain.example
# Leave unset until you supply a unique random secret of at least 32 characters.
BETTER_AUTH_SECRET=
DATABASE_URL=postgresql://user:password@your-neon-host.example/garden?sslmode=verify-full
GOOGLE_CLIENT_ID=replace-with-google-web-client-id
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
RESEND_API_KEY=replace-with-resend-api-key
AUTH_EMAIL_FROM=Friendship Garden <sign-in@mail.your-domain.example>
